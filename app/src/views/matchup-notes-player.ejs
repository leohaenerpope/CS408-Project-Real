<div class="container py-5">
  
    <div class="card bg-dark text-white shadow-lg border-secondary">
      
      <div class="card-header custom-card text-center">
        <h2 class="mb-0">
          Matchup Notes For: 
          <span class="text-info"><%= playerName %></span>
        </h2>
      </div>
      <div class="card-body p-4">
        
        <div class="row mb-4 align-items-center">
          <div class="col-md-6">
            <label class="form-label fw-bold">Displaying Matchup Notes Against:</label>
            <form id="filterForm" method="GET" action="/matchups/<%= playerId %>">
            <select
            class="form-select bg-secondary text-white border-0"
            onchange="this.form.submit()"
            name="opponent"
            form="filterForm"
            >
              <option value="all" <%= dropdownOppId === 'all' ? 'selected' : '' %>>
                Everyone
              </option>
          
              <% opponents.forEach(opponent => { %>
                <option 
                  value="<%= opponent.id %>" 
                  <%= String(dropdownOppId) === String(opponent.id) ? 'selected' : '' %>
                >
                  <%= opponent.name %>
                </option>
              <% }) %>
            </select>
            </form>
          </div>
          <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="/matchups/<%= playerId %>/add" class="btn btn-success">+ Add New Note</a>
          </div>
        </div>
  
        <hr class="border-secondary">
  
        <div class="matchup-list">
          
          <% if (matchups.length === 0) { %> 
            <p>No matchup notes to display.</p>
          <% } %>

          <% matchups.forEach(matchup => { %>
            <div class="card bg-dark text-white border-primary mb-4">
              <div class="card-header bg-primary d-flex justify-content-between">
                <span><strong>Against:</strong> <%= matchup.opponentName %></span>
                <span><strong>Matchup Date:</strong> <%= matchup.formattedDate %></span>
              </div>
        
              <div class="card-body">
                <div class="row text-center mb-3 border-bottom border-secondary pb-2">
                  <div class="col-4"><strong><%= matchup.points %></strong> PTS</div>
                  <div class="col-4"><strong><%= matchup.assists %></strong> AST</div>
                  <div class="col-4"><strong><%= matchup.rebounds %></strong> REB</div>
                </div>
        
                <p class="card-text text-light-50 italic">
                  <%= matchup.notes %>
                </p>
        
                <div class="mt-3 text-end">
                  <a href="/matchups/<%= playerId %>/edit/<%= matchup.id %>" class="btn btn-sm btn-outline-warning me-2">
                    Manage
                  </a>
                  <button 
                    type="button"
                    class="btn btn-sm btn-outline-danger"
                    onclick="startDeleteAsk(
                      '/matchups/<%= playerId %>/delete/<%= matchup.id %>',
                      'Are you sure you want to delete this matchup note?'
                    )">
                    Delete Note
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
  
        </div> </div>
    </div>
  </div>