<div class="container py-5">

  <!-- Title -->
    <div class="card custom-card text-white shadow">
      <div class="card-header custom-card text-white">
        <h2 class="mb-0 text-center">Player List</h2>
      </div>
      <div class="card-body bg-dark">        
        <table class="table table-dark table-hover">
          <thead>
            <tr>
              <th>Player Name</th>
              <th>Options</th>
            </tr>
          </thead>

          <!-- Display players -->
          <tbody>
            <% if (players.length === 0) { %>
              <tr>
                <td colspan="2" class="text-center">No players found</td>
              </tr>
            <% } else { %>
              <% players.forEach(player => { %>
                <tr>
                  <td><%= player.name %></td>
                  <td>
                    <a href="/matchups/<%= player.id %>" class="btn btn-sm btn-outline-info">
                      Matchup Notes
                    </a>
                    <button 
                      type="button"
                      class="btn btn-sm btn-outline-danger"
                      onclick="startDeleteAsk(
                        '/players/delete/<%= player.id %>',
                        'Are you sure you want to delete this player?'
                      )">
                      Delete Player
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>

        </table>
      </div>
    </div>
    <div class="mt-4 text-end">
      <a href="/players/add" class="btn btn-primary btn-lg px-5">
        Add Player
      </a>
    </div>
  </div>